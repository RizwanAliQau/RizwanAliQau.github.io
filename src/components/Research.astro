---
import { researchHighlights } from '../data/site';
---

<section id="research" class="border-b divider-line py-16 sm:py-24">
  <div class="section-shell">
    <div class="max-w-2xl">
      <p class="section-title">Selected Research</p>
      <h2 class="section-heading">Systems built for label-efficient inspection</h2>
      <p class="section-lede">
        Core contributions spanning synthetic anomaly generation, coarse-to-fine segmentation, and multi-class detection.
      </p>
    </div>

    <ol class="mt-14 grid gap-10 sm:grid-cols-3 sm:gap-8">
      {
        researchHighlights.map((item, index) => (
          <li class="group relative">
            <p class="font-display text-5xl text-signal/25 transition duration-500 group-hover:text-signal/45 dark:text-teal-300/25 dark:group-hover:text-teal-300/50">
              {String(index + 1).padStart(2, '0')}
            </p>
            <h3 class="mt-3 font-display text-2xl text-ink dark:text-paper">{item.name}</h3>
            <p class="mt-3 text-sm leading-7 text-ink-muted dark:text-slate-300">{item.blurb}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
