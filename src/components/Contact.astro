---
import { site } from '../data/site';
---

<section id="contact" class="relative overflow-hidden py-20 sm:py-28">
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-full bg-[radial-gradient(ellipse_at_center,rgba(15,118,110,0.12),transparent_60%)] dark:bg-[radial-gradient(ellipse_at_center,rgba(45,212,191,0.12),transparent_60%)]"
    aria-hidden="true"
  ></div>
  <div class="section-shell relative text-center">
    <p class="section-title">Contact</p>
    <h2 class="mx-auto max-w-2xl font-display text-4xl leading-tight text-ink dark:text-paper sm:text-5xl">
      Let's build the next inspection system
    </h2>
    <p class="mx-auto mt-5 max-w-prose text-ink-muted dark:text-slate-300">
      Open to research collaborations in computer vision, anomaly detection, and industrial AI.
    </p>
    <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
      <a href={site.cvPath} class="btn-primary" download>
        Download CV
      </a>
      <a href={`mailto:${site.email}`} class="btn-secondary">
        {site.email}
      </a>
    </div>
    <div class="mt-10 flex flex-wrap items-center justify-center gap-6 text-sm">
      {
        site.affiliations.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="text-ink-muted underline-offset-4 transition hover:text-signal hover:underline dark:text-slate-400 dark:hover:text-teal-300"
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </div>
</section>

<footer class="border-t divider-line py-8">
  <div class="section-shell flex flex-col gap-3 text-sm text-ink-muted dark:text-slate-400 sm:flex-row sm:items-center sm:justify-between">
    <p>© {new Date().getFullYear()} {site.name}</p>
    <p class="max-w-prose sm:text-right">{site.footerFocus}</p>
  </div>
</footer>
