---
import PublicationCard from './PublicationCard.astro';
import { publications, workingPapers } from '../data/publications';

const journalPapers = publications.filter((p) => p.type === 'journal');
const conferencePapers = publications.filter((p) => p.type === 'conference');
---

<section id="publications" class="border-b divider-line py-16 sm:py-24">
  <div class="section-shell">
    <div class="max-w-2xl">
      <p class="section-title">Publications</p>
      <h2 class="section-heading">Peer-reviewed research</h2>
      <p class="section-lede">
        Journal and conference work in visual anomaly detection, self-supervised learning, and industrial computer vision.
      </p>
    </div>

    <div class="mt-12">
      <h3 class="text-xs font-semibold uppercase tracking-[0.18em] text-ink-faint">
        Journal Articles
      </h3>
      <div class="mt-2 border-t border-paper-border/70 dark:border-white/10">
        {journalPapers.map((paper) => <PublicationCard publication={paper} />)}
      </div>
    </div>

    <div class="mt-12">
      <h3 class="text-xs font-semibold uppercase tracking-[0.18em] text-ink-faint">
        Conference Papers
      </h3>
      <div class="mt-2 border-t border-paper-border/70 dark:border-white/10">
        {conferencePapers.map((paper) => <PublicationCard publication={paper} />)}
      </div>
    </div>

    {
      workingPapers.length > 0 && (
        <div class="mt-12">
          <h3 class="text-xs font-semibold uppercase tracking-[0.18em] text-ink-faint">
            Working Papers
          </h3>
          <div class="mt-2 border-t border-paper-border/70 dark:border-white/10">
            {workingPapers.map((paper) => (
              <PublicationCard publication={paper} />
            ))}
          </div>
        </div>
      )
    }
  </div>
</section>
