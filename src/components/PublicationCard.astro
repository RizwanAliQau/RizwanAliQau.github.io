---
import type { Publication } from '../data/publications';

interface Props {
  publication: Publication;
}

const { publication } = Astro.props;

const typeLabel = {
  journal: 'Journal',
  conference: 'Conference',
  'working-paper': 'Working Paper',
}[publication.type];
---

<article class="group grid gap-3 border-b border-paper-border/70 py-6 last:border-b-0 dark:border-white/10 sm:grid-cols-[5.5rem_1fr_auto] sm:gap-6 sm:py-7">
  <div class="flex items-center gap-3 sm:flex-col sm:items-start sm:gap-1">
    <span class="text-xs font-semibold uppercase tracking-[0.16em] text-signal dark:text-teal-300">
      {typeLabel}
    </span>
    <span class="text-sm text-ink-faint">{publication.year}</span>
  </div>

  <div>
    <h4 class="text-base font-semibold leading-snug text-ink dark:text-paper sm:text-lg">
      {
        publication.href ? (
          <a
            href={publication.href}
            target="_blank"
            rel="noopener noreferrer"
            class="transition hover:text-signal dark:hover:text-teal-300"
          >
            {publication.title}
          </a>
        ) : (
          publication.title
        )
      }
    </h4>
    <p class="mt-2 text-sm text-ink-muted dark:text-slate-400">{publication.authors}</p>
    <p class="mt-1 text-sm font-medium text-ink/80 dark:text-slate-200">{publication.venue}</p>
    {
      publication.note && (
        <p class="mt-2 text-sm text-ink-muted dark:text-slate-400">{publication.note}</p>
      )
    }
  </div>

  {
    publication.href && (
      <a
        href={publication.href}
        target="_blank"
        rel="noopener noreferrer"
        class="self-start text-sm font-medium text-signal transition group-hover:translate-x-0.5 dark:text-teal-300"
      >
        DOI →
      </a>
    )
  }
</article>
