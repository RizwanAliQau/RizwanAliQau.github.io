---
import { experience } from '../data/experience';
---

<section id="experience" class="border-b divider-line py-16 sm:py-24">
  <div class="section-shell">
    <div class="max-w-2xl">
      <p class="section-title">Experience</p>
      <h2 class="section-heading">Research & engineering timeline</h2>
      <p class="section-lede">
        Roles spanning national-scale funded projects and applied AI for smart manufacturing.
      </p>
    </div>

    <ol class="mt-14 space-y-0">
      {
        experience.map((entry) => (
          <li class="relative grid gap-4 border-l border-signal/25 py-10 pl-8 first:pt-0 last:pb-0 sm:grid-cols-[11rem_1fr] sm:gap-12 sm:pl-10">
            <span
              class="absolute -left-[5px] top-12 h-2.5 w-2.5 rounded-full bg-signal first:top-1.5 sm:top-[3.05rem]"
              aria-hidden="true"
            />
            <div class="text-sm">
              <p class="font-medium text-ink dark:text-paper">{entry.period}</p>
              <p class="mt-1 text-ink-faint">{entry.location}</p>
            </div>

            <article>
              <h3 class="font-display text-2xl text-ink dark:text-paper">{entry.role}</h3>
              <p class="mt-1 text-sm font-medium text-signal dark:text-teal-300">{entry.organization}</p>
              <p class="mt-4 max-w-prose text-sm leading-7 text-ink-muted dark:text-slate-300">
                {entry.summary}
              </p>

              {entry.projects && entry.projects.length > 0 && (
                <div class="mt-6 space-y-5">
                  <p class="text-xs font-semibold uppercase tracking-[0.18em] text-ink-faint">
                    Funded Projects
                  </p>
                  {entry.projects.map((project) => (
                    <div class="border-l-2 border-signal/40 pl-4">
                      <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                        <h4 class="text-sm font-semibold text-ink dark:text-paper">{project.title}</h4>
                        <span class="text-xs font-medium text-signal dark:text-teal-300">
                          {project.funding}
                        </span>
                      </div>
                      <p class="mt-2 text-sm leading-6 text-ink-muted dark:text-slate-400">
                        {project.description}
                      </p>
                    </div>
                  ))}
                </div>
              )}

              {entry.highlights && entry.highlights.length > 0 && (
                <ul class="mt-6 space-y-2 text-sm text-ink-muted dark:text-slate-300">
                  {entry.highlights.map((highlight) => (
                    <li class="flex gap-3">
                      <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-signal" />
                      <span>{highlight}</span>
                    </li>
                  ))}
                </ul>
              )}
            </article>
          </li>
        ))
      }
    </ol>
  </div>
</section>
