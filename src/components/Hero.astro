---
import { site } from '../data/site';

const nav = [
  { href: '#research', label: 'Research' },
  { href: '#experience', label: 'Experience' },
  { href: '#publications', label: 'Publications' },
  { href: '#skills', label: 'Skills' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="sticky top-0 z-50 border-b border-paper-border/60 bg-paper/75 backdrop-blur-md dark:border-white/10 dark:bg-ink/70">
  <div class="section-shell flex items-center justify-between py-3.5">
    <a href="/" class="font-display text-lg tracking-tight text-ink transition hover:text-signal dark:text-paper dark:hover:text-teal-300">
      {site.name}
    </a>
    <div class="flex items-center gap-2 sm:gap-4">
      <nav class="hidden items-center gap-5 text-sm text-ink-muted md:flex dark:text-slate-300">
        {
          nav.map((item) => (
            <a href={item.href} class="transition hover:text-ink dark:hover:text-paper">
              {item.label}
            </a>
          ))
        }
      </nav>
      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle dark mode"
        class="rounded-md border border-paper-border/80 p-2 text-ink-muted transition hover:border-signal/40 hover:text-ink dark:border-white/15 dark:text-slate-300 dark:hover:text-paper"
      >
        <svg class="h-4 w-4 dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" />
        </svg>
        <svg class="hidden h-4 w-4 dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
        </svg>
      </button>
    </div>
  </div>
</header>

<section class="relative overflow-hidden border-b divider-line">
  <div class="pointer-events-none absolute inset-0 optical-grid animate-fade" aria-hidden="true"></div>
  <div
    class="pointer-events-none absolute -left-24 top-10 h-72 w-72 rounded-full bg-signal/20 blur-3xl animate-drift dark:bg-teal-400/15"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute -right-16 bottom-0 h-80 w-80 rounded-full bg-ink/10 blur-3xl animate-drift dark:bg-slate-200/10"
    style="animation-delay: -6s"
    aria-hidden="true"
  ></div>

  <div class="section-shell relative flex min-h-[calc(100svh-3.75rem)] flex-col justify-center py-16 sm:py-24">
    <p class="section-title animate-rise">{site.role}</p>
    <h1 class="mt-5 max-w-4xl font-display text-5xl leading-[1.05] tracking-tight text-ink animate-rise-delay dark:text-paper sm:text-6xl lg:text-7xl">
      {site.name}
    </h1>
    <p class="mt-6 max-w-xl text-lg text-ink-muted animate-rise-delay-2 dark:text-slate-300 sm:text-xl">
      {site.focusLine}
    </p>
    <div class="mt-10 flex flex-wrap gap-3 animate-rise-delay-2">
      <a href={site.cvPath} class="btn-primary" download>
        Download CV
      </a>
      <a href={`mailto:${site.email}`} class="btn-secondary">
        {site.email}
      </a>
    </div>
  </div>
</section>

<section id="about" class="border-b divider-line py-14 sm:py-16">
  <div class="section-shell grid gap-10 lg:grid-cols-[1.35fr_0.9fr] lg:gap-16">
    <div>
      <p class="section-title">About</p>
      <h2 class="section-heading">Vision systems that inspect with less labels</h2>
      <p class="section-lede whitespace-pre-line">{site.about}</p>
    </div>
    <dl class="grid gap-6 self-end border-l border-signal/30 pl-6 sm:pl-8">
      <div>
        <dt class="text-xs font-semibold uppercase tracking-[0.18em] text-ink-faint">Education</dt>
        <dd class="mt-2 text-sm leading-relaxed text-ink-muted dark:text-slate-300">{site.education}</dd>
      </div>
      <div>
        <dt class="text-xs font-semibold uppercase tracking-[0.18em] text-ink-faint">Affiliation</dt>
        <dd class="mt-2 text-sm leading-relaxed text-ink-muted dark:text-slate-300">
          MSIS Lab · {site.location}
        </dd>
      </div>
      <div>
        <dt class="text-xs font-semibold uppercase tracking-[0.18em] text-ink-faint">Focus</dt>
        <dd class="mt-2 text-sm leading-relaxed text-ink-muted dark:text-slate-300">
          Self-supervised learning · Pseudo-anomaly insertion · Industrial visual inspection
        </dd>
      </div>
    </dl>
  </div>
</section>
